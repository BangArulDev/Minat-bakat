
model RiasecResult {
  id            String   @id @default(uuid())
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  rawScores     String
  dominantCode  String
  consistency   String?

  // Jawaban soal 1 sampai 216
  answers       Json?

  // Nilai Self-Estimate 1 sampai 12
  selfEstimates Json?

  createdAt     DateTime @default(now())
}
